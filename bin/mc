#!/usr/bin/env bash
# Wrapper: runs the MinIO client `mc` via the official `minio/mc` Docker image.
# No host install. Stateless auth via MC_HOST_<alias>. /tmp and the current directory
# are mounted so --policy files are readable inside the container.
set -euo pipefail

ALIAS="${INTAKE_MC_ALIAS:-myminio}"
AK="${INTAKE_ADMIN_ACCESS_KEY:-minioadmin}"
SK="${INTAKE_ADMIN_SECRET_KEY:-minioadmin}"
# MinIO address reachable from the container (host network).
HOSTPORT="${INTAKE_MC_HOSTPORT:-localhost:9000}"
IMAGE="${INTAKE_MC_IMAGE:-minio/mc:latest}"

exec docker run --rm --network host \
  -e "MC_HOST_${ALIAS}=http://${AK}:${SK}@${HOSTPORT}" \
  -v /tmp:/tmp \
  -v "$PWD":"$PWD" -w "$PWD" \
  --entrypoint mc \
  "$IMAGE" "$@"
