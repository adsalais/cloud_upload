# Rust
/target
**/*.rs.bk
# Cargo.lock IS committed (application binary -> reproducible builds, supply-chain safety)

# Node / site build
node_modules/
dist/
.vite/

# Secrets & case state — NEVER COMMIT
# (gitignore does NOT accept end-of-line comments: a pattern must stand alone)
.env
.env.*
*.creds
*.secret
# persisted case state (may contain key credentials):
cases/
**/cases/
secrets/

# Local MinIO data
.minio-data/
minio-data/

# Misc
.DS_Store
*.log
